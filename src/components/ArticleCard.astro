---
interface Props {
  title: string;
  summary: string;
  category: string;
  date: Date;
  slug: string;
  author?: string;
  variant?: 'default' | 'featured-main' | 'featured-side';
}

const {
  title,
  summary,
  category,
  date,
  slug,
  author = 'Daniel Reeves',
  variant = 'default',
} = Astro.props;

const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// article slug like "best-slow-cookers-2026" → image dir "slow-cookers"
// but "best-air-fryer-toaster-oven-combos-2026" → "air-fryer-toaster-oven"
// and "best-portable-induction-cooktops-2026" → "portable-induction"
// so we use an explicit lookup
const ARTICLE_TO_IMAGE_DIR: Record<string, string> = {
  'best-air-fryer-toaster-oven-combos-2026': 'air-fryer-toaster-oven',
  'best-portable-induction-cooktops-2026': 'portable-induction',
  'best-slow-cookers-2026': 'slow-cookers',
  'best-humidifiers-2026': 'humidifiers',
  'best-electric-kettles-2026': 'electric-kettles',
  'best-space-heaters-2026': 'space-heaters',
  'best-air-purifiers-2026': 'air-purifiers',
  'best-blenders-2026': 'blenders',
  'best-robot-vacuums-2026': 'robot-vacuums',
  'best-mechanical-keyboards-2026': 'mechanical-keyboards',
};
const imageSlug = ARTICLE_TO_IMAGE_DIR[slug];
// Slugs that have a downloaded hero image on disk
const AVAILABLE_IMAGES = new Set([
  'air-fryer-toaster-oven',
  'portable-induction',
  'slow-cookers',
  'humidifiers',
  'electric-kettles',
  'space-heaters',
  'air-purifiers',
  'blenders',
  'robot-vacuums',
]);
const hasImage = !!imageSlug && AVAILABLE_IMAGES.has(imageSlug);
const heroImage = hasImage ? `/images/reviews/${imageSlug}/hero.jpg` : null;
const categorySlug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const variantClass = variant !== 'default' ? ` article-card--${variant}` : '';
---
<article class={`article-card${variantClass}`}>
  {hasImage && (
    <a class="article-card__image-link" href={`/reviews/${slug}/`}>
      <img
        src={heroImage}
        alt={title}
        class="article-card__image"
        loading="lazy"
        width="600"
        height="450"
      />
    </a>
  )}
  <div class="article-card__content">
    <p class="article-card__category">
      <a href={`/categories/${categorySlug}/`}>{category}</a>
    </p>
    <h2 class="article-card__title">
      <a href={`/reviews/${slug}/`}>{title}</a>
    </h2>
    <p class="article-card__summary">{summary}</p>
    <p class="article-card__meta">By {author} · {dateStr}</p>
  </div>
</article>