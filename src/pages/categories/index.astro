---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../data/categories';

const articles = await getCollection('reviews');

const countsByCategory = new Map<string, number>();
for (const article of articles) {
  const cat = article.data.category;
  countsByCategory.set(cat, (countsByCategory.get(cat) ?? 0) + 1);
}

const categories = CATEGORIES.map(cat => ({
  ...cat,
  count: countsByCategory.get(cat.name) ?? 0,
}));
---
<BaseLayout
  title="Browse by Category"
  description="All Sourcedreviews categories, organized by topic."
>
  <section class="hero">
    <div class="container">
      <h1>Browse by category</h1>
      <p>
        Every roundup we publish lives in one category. Pick the category you care about to see the relevant reviews.
      </p>
    </div>
  </section>

  <section class="container" style="margin-top: 2.5rem;">
    <div class="category-grid">
      {categories.map(cat => (
        <a class="category-card" href={`/categories/${cat.slug}/`}>
          <h2>{cat.name}</h2>
          <p class="category-description">{cat.description}</p>
          <p class="category-meta">
            {cat.count} {cat.count === 1 ? 'review' : 'reviews'}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin: 1rem 0 3rem;
  }
  .category-card {
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: 4px;
    transition: border-color 0.2s;
    text-decoration: none;
    color: var(--color-text);
    display: block;
  }
  .category-card:hover {
    border-color: var(--color-accent);
  }
  .category-card h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }
  .category-description {
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .category-meta {
    font-size: 0.85rem;
    color: var(--color-accent-dark);
    font-weight: 600;
  }
</style>
