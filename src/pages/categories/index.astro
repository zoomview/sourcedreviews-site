---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('reviews');

const categoriesMap = new Map<string, typeof articles>();
for (const article of articles) {
  const cat = article.data.category;
  if (!categoriesMap.has(cat)) categoriesMap.set(cat, []);
  categoriesMap.get(cat)!.push(article);
}

const categories = Array.from(categoriesMap.entries())
  .map(([name, items]) => ({
    name,
    slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    count: items.length,
    description: categoryDescription(name),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

function categoryDescription(name: string): string {
  const descriptions: Record<string, string> = {
    'Home & Kitchen': 'Counter-top ovens, induction cooktops, and other small appliances we have evaluated against published testing and aggregated buyer feedback.',
    'Tech': 'Consumer electronics and computer peripherals, judged on measured performance and long-term owner reports.',
    'Personal Care': 'Hair clippers, electric shavers, and similar grooming tools.',
  };
  return descriptions[name] ?? `Articles in the ${name} category.`;
}
---
<BaseLayout
  title="Browse by Category"
  description="All Sourcedreviews categories, organized by topic."
>
  <section class="hero">
    <div class="container">
      <h1>Browse by category</h1>
      <p>
        Every roundup we publish lives in one category. Pick the category you care about to see the relevant reviews.
      </p>
    </div>
  </section>

  <section class="container" style="margin-top: 2.5rem;">
    <div class="category-grid">
      {categories.map(cat => (
        <a class="category-card" href={`/categories/${cat.slug}/`}>
          <h2>{cat.name}</h2>
          <p class="category-description">{cat.description}</p>
          <p class="category-meta">{cat.count} {cat.count === 1 ? 'review' : 'reviews'}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin: 1rem 0 3rem;
  }
  .category-card {
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: 4px;
    transition: border-color 0.2s;
    text-decoration: none;
    color: var(--color-text);
    display: block;
  }
  .category-card:hover {
    border-color: var(--color-accent);
  }
  .category-card h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }
  .category-description {
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .category-meta {
    font-size: 0.85rem;
    color: var(--color-accent-dark);
    font-weight: 600;
  }
</style>
