---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, getCategoryBySlug } from '../../data/categories';

export async function getStaticPaths() {
  const articles = await getCollection('reviews');

  // Use CATEGORIES as the source of truth for which category routes to generate.
  // Articles are filtered into the matching category by frontmatter `category` name.
  return CATEGORIES.map(cat => {
    const items = articles
      .filter(a => a.data.category === cat.name)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { slug: cat.slug },
      props: {
        categoryName: cat.name,
        categorySlug: cat.slug,
        categoryDescription: cat.description,
        articles: items,
      },
    };
  });
}

const { categoryName, categorySlug, categoryDescription, articles } = Astro.props;
---
<BaseLayout
  title={`${categoryName} Reviews`}
  description={`Independent product reviews in the ${categoryName} category, sourced from published research and aggregated verified-buyer feedback.`}
>
  <section class="hero">
    <div class="container">
      <p class="hero-eyebrow">Category</p>
      <h1>{categoryName}</h1>
      <p>{categoryDescription}</p>
    </div>
  </section>

  <section class="container" style="margin-top: 2rem;">
    <p style="margin-bottom: 1rem;"><a href="/categories/">← All categories</a></p>
    {articles.length === 0 ? (
      <p style="color: var(--color-muted);">No reviews published in this category yet.</p>
    ) : (
      <div class="article-grid">
        {articles.map(article => (
          <ArticleCard
            title={article.data.title}
            summary={article.data.summary}
            category={article.data.category}
            date={article.data.date}
            slug={article.slug}
            author={article.data.author}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .hero-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-dark);
    font-weight: 600;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
</style>
